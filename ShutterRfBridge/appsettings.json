{
  "NLog": {
    "throwConfigExceptions": true,
    "targets": {
      "file": {
        "type": "AutoFlushWrapper",
        "condition": "level >= LogLevel.Error",
        "target": {
          "type": "BufferingWrapper",
          "bufferSize": 100,
          "flushTimeout": 300000,
          "slidingTimeout": false,
          "target": {
            "type": "File",
            "fileName": "/var/log/shutter-rf-bridge/shutter-rf-bridge.log",
            "layout": "${longdate} ${level:uppercase=true} ${logger} ${message:withexception=true}",
            "archiveEvery": "Day",
            "archiveAboveSize": 320000,
            "maxArchiveFiles": 32,
            "maxArchiveDays": 31
          }
        }
      }
    },
    "rules": [
      {
        "logger": "Microsoft.AspNetCore.*",
        "maxLevel": "Info",
        "final": true
      },
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "file"
      }
    ]
  }
}
