<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Coverage of the production project, enforced on every test run; the threshold only goes up. -->
    <TestingPlatformCommandLineArguments>--coverlet --coverlet-include "[ShutterRfBridge]*" --coverlet-threshold 90</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NSubstitute.Analyzers.CSharp" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShutterRfBridge\ShutterRfBridge.csproj" />
  </ItemGroup>

</Project>
