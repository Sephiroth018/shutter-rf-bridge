<Project>
  <PropertyGroup>
    <Description>Controls 433 MHz radio shutters from a Homematic CCU3 through a Raspberry Pi.</Description>
    <Authors>Sephiroth018</Authors>
    <RepositoryUrl>https://github.com/Sephiroth018/shutter-rf-bridge</RepositoryUrl>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
