// The service's house values, over the built-in settings. deploy.sh copies this template to
// /etc/shutter-rf-bridge/appsettings.json once and never overwrites it. After a change there,
// restart the service: sudo systemctl restart shutter-rf-bridge
{
  "Bridge": {
    // The remote's ID, decimal or 0x… hex, in quotes.
    "RemoteId": "",
    // The IP addresses allowed to send commands: the CCU, and the Pi itself for checks with curl.
    "AllowedClients": [
      "",
      "127.0.0.1"
    ]
  },
  // The address and port the service listens on; 0.0.0.0 means every network interface.
  "Urls": "http://0.0.0.0:5080",
  // Remove the // in front of the next line to write every log line at once instead of in
  // batches, e.g. to watch the log live. Spares the SD card when left off.
  //"NLog": { "targets": { "file": { "target": { "bufferSize": 1 } } } }
}
