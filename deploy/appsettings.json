// The service's local settings, over the built-in settings. deploy.sh copies this template to
// /etc/shutter-rf-bridge/appsettings.json once and never overwrites it. After a change there,
// restart the service: sudo systemctl restart shutter-rf-bridge
{
  "Bridge": {
    // The remote's ID, decimal or 0x… hex, in quotes.
    "RemoteId": "",
    // The IP addresses allowed to send commands: the CCU, and the Pi itself for checks with curl.
    "AllowedClients": [
      "",
      "127.0.0.1"
    ]
  },
  "Weather": {
    // The coordinates for the nowcast endpoint, in decimal degrees with a decimal point. To get the rain,
    // remove the // in front of the four lines below and fill in both. Left as it is, the service
    // logs an error at startup and the rain endpoint answers one; the shutters work either way.
    // "Location": {
    //   "Latitude": "",
    //   "Longitude": ""
    // }
  },
  // The address and port the service listens on; 0.0.0.0 means every network interface.
  "Urls": "http://0.0.0.0:5080"
}
