# The service's house values, read by its systemd unit. deploy.sh copies this template to
# /etc/default/shutter-rf-bridge once and never overwrites it. After a change there, restart the
# service: sudo systemctl restart shutter-rf-bridge

# The remote's ID, decimal or 0x… hex.
Bridge__RemoteId=

# The IP addresses allowed to send commands: the CCU, and the Pi itself for checks with curl.
# Further ones continue the numbering (Bridge__AllowedClients__2=…).
Bridge__AllowedClients__0=
Bridge__AllowedClients__1=127.0.0.1

# The address and port the service listens on; 0.0.0.0 means every network interface.
ASPNETCORE_URLS=http://0.0.0.0:5080

# Remove the # to write every log line at once instead of buffering up to 5 minutes, e.g. to
# watch the log live. Spares the SD card when left off.
#NLog__targets__file__target__bufferSize=1
